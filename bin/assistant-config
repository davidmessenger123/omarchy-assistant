#!/usr/bin/env bash
# Manage Omarchy Assistant image generation settings.
set -euo pipefail

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-assistant"
key_file="$config_dir/gemini.key"
script_dir="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
image_helper="$script_dir/assistant_image_local.py"

pictures_root() {
    if [[ -n "${XDG_PICTURES_DIR:-}" ]]; then
        printf '%s\n' "${XDG_PICTURES_DIR/#\$HOME/$HOME}"
        return
    fi
    if [[ -r "$HOME/.config/user-dirs.dirs" ]]; then
        local value
        value="$(sed -n 's/^XDG_PICTURES_DIR="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$HOME/.config/user-dirs.dirs" | head -n 1)"
        if [[ -n "$value" ]]; then
            printf '%s\n' "${value/#\$HOME/$HOME}"
            return
        fi
    fi
    printf '%s\n' "$HOME/Pictures"
}

output_dir() {
    if [[ -n "${ASSISTANT_IMAGE_DIR:-}" ]]; then
        printf '%s\n' "${ASSISTANT_IMAGE_DIR/#\$HOME/$HOME}"
        return
    fi
    printf '%s\n' "$(pictures_root)/omarchy-assistant"
}

store_key() {
    local value="$1"
    if ((${#value} < 20)); then
        printf 'That key looks too short; expected a Gemini API key of at least 20 characters.\n' >&2
        return 1
    fi
    if [[ "$value" == *$'\n'* || "$value" =~ [[:space:]] ]]; then
        printf 'The key must be a single token with no spaces.\n' >&2
        return 1
    fi
    umask 077
    mkdir -p "$config_dir"
    printf '%s\n' "$value" > "$key_file"
    chmod 600 "$key_file"
    printf 'Saved Gemini API key to %s (mode 600).\n' "$key_file"
}

image_venv() {
    printf '%s\n' "${ASSISTANT_IMAGE_VENV:-${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-assistant/image-venv}"
}

image_python() {
    printf '%s\n' "${ASSISTANT_IMAGE_PYTHON:-$(image_venv)/bin/python}"
}

# Which GPU vendor is present? Prints nvidia, amd, intel, or none.
detect_gpu_vendor() {
    local override="${ASSISTANT_IMAGE_TORCH_BACKEND:-}"
    case "$override" in
        nvidia | amd | intel | none) printf '%s\n' "$override"; return ;;
        "") ;;
        *) printf '%s\n' "$override"; return ;;
    esac
    if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then
        printf 'nvidia\n'
        return
    fi
    if command -v rocminfo >/dev/null 2>&1 && rocminfo >/dev/null 2>&1; then
        printf 'amd\n'
        return
    fi
    local vendor
    vendor="$(lspci 2>/dev/null | rg -i 'vga compatible controller|3d controller|display controller' | rg -io 'nvidia|amd|ati|intel' | head -n 1 || true)"
    case "$vendor" in
        nvidia) printf 'nvidia\n' ;;
        amd | ati) printf 'amd\n' ;;
        intel) printf 'intel\n' ;;
        *) printf 'none\n' ;;
    esac
}

detect_rocm_version() {
    if [[ -n "${ASSISTANT_ROCM_VERSION:-}" ]]; then
        printf '%s\n' "${ASSISTANT_ROCM_VERSION#rocm}"
        return
    fi
    local version=""
    if [[ -r /opt/rocm/.info/version ]]; then
        version="$(cut -d- -f1 /opt/rocm/.info/version | tr -dc '0-9.')"
    fi
    if [[ -z "$version" ]] && command -v rocminfo >/dev/null 2>&1; then
        version="$(rocminfo 2>/dev/null | rg -o 'ROCm version: [0-9]+\.[0-9]+\.[0-9]+' | head -n 1 | rg -o '[0-9]+\.[0-9]+\.[0-9]+' || true)"
    fi
    # Only indexes that publish PyTorch builds are usable.
    case "${version%.*}" in
        6.2 | 6.3 | 6.4 | 7.0 | 7.1) printf '%s\n' "${version%.*}" ;;
        *) printf '6.4\n' ;;
    esac
}

image_setup_plan() {
    local vendor rocm
    vendor="$(detect_gpu_vendor)"
    rocm="$(detect_rocm_version)"
    printf 'gpu_vendor=%s\n' "$vendor"
    printf 'python=%s\n' "$(image_python)"
    printf 'helper=%s\n' "$image_helper"
    printf 'model=%s\n' "${ASSISTANT_IMAGE_LOCAL_MODEL:-stabilityai/sdxl-turbo}"
    case "$vendor" in
        amd)
            printf 'torch_index=https://download.pytorch.org/whl/rocm%s\n' "$rocm"
            printf 'rocm_detected=%s\n' "$rocm"
            if ! command -v rocminfo >/dev/null 2>&1; then
                printf 'rocm_installed=no\n'
                printf 'note=Install ROCm first (Arch: pacman -S rocm rocm-hip; see https://rocm.docs.amd.com for other distributions), then re-run this command.\n'
            else
                printf 'rocm_installed=yes\n'
            fi
            ;;
        intel)
            printf 'torch_index=default\n'
            printf 'note=Intel GPUs have no supported PyTorch SDXL path here; generation will fall back to the CPU. Use the gemini backend or an NVIDIA/AMD machine for local generation.\n'
            ;;
        *)
            printf 'torch_index=default\n'
            ;;
    esac
}

image_status() {
    local python_bin model
    python_bin="$(image_python)"
    model="${ASSISTANT_IMAGE_LOCAL_MODEL:-stabilityai/sdxl-turbo}"
    printf 'local_python=%s\n' "$python_bin"
    printf 'gpu_vendor=%s\n' "$(detect_gpu_vendor)"
    if [[ ! -x "$python_bin" ]]; then
        printf 'local_installed=no\n'
        printf 'next_step=run bin/assistant-config setup-image-models\n'
        return 0
    fi
    printf 'local_installed=yes\n'
    printf 'local_model=%s\n' "$model"
    "$python_bin" "$image_helper" doctor 2>/dev/null || printf 'doctor_failed=1\n'
}

setup_image_models() {
    local prefetch=1 venv python_bin vendor rocm torch_args=() rebuild_torch=0
    while (($# > 0)); do
        case "$1" in
            --no-prefetch)
                prefetch=0
                ;;
            --rebuild-torch)
                rebuild_torch=1
                ;;
            --rocm)
                shift
                ASSISTANT_ROCM_VERSION="${1:-}"
                if [[ -z "$ASSISTANT_ROCM_VERSION" ]]; then
                    printf -- '--rocm needs a version, for example --rocm 6.4\n' >&2
                    exit 1
                fi
                ;;
            --backend)
                shift
                ASSISTANT_IMAGE_TORCH_BACKEND="${1:-}"
                if [[ -z "$ASSISTANT_IMAGE_TORCH_BACKEND" ]]; then
                    printf -- '--backend needs a vendor: nvidia, amd, intel, or none\n' >&2
                    exit 1
                fi
                ;;
            *)
                printf 'Unknown option: %s\n' "$1" >&2
                exit 1
                ;;
        esac
        shift
    done
    venv="$(image_venv)"
    python_bin="$(image_python)"
    helper="$image_helper"
    vendor="$(detect_gpu_vendor)"
    rocm="$(detect_rocm_version)"
    if [[ ! -x "$python_bin" ]]; then
        printf 'Creating the local image environment in %s\n' "$venv"
        mkdir -p "$(dirname "$venv")"
        "${PYTHON:-python3}" -m venv "$venv" || {
            printf 'Could not create the virtual environment.\n' >&2
            exit 1
        }
    fi
    "$python_bin" -m pip install --upgrade pip >/dev/null

    if [[ "$vendor" == "amd" ]]; then
        if ((rebuild_torch == 0)) && "$python_bin" -c 'import torch, sys; sys.exit(0 if getattr(torch.version, "hip", None) else 1)' 2>/dev/null; then
            printf 'PyTorch already has a ROCm build; keeping it.\n'
        else
            printf 'Installing a ROCm %s PyTorch build for the AMD GPU.\n' "$rocm"
            if ! command -v rocminfo >/dev/null 2>&1; then
                printf 'Warning: rocminfo was not found. Install ROCm before generating, or PyTorch will not see the GPU.\n' >&2
                printf '  Arch: sudo pacman -S rocm rocm-hip rocm-smi-lib\n' >&2
                printf '  Others: see https://rocm.docs.amd.com/projects/radeon/en/latest/docs/install.html\n' >&2
            fi
            "$python_bin" -m pip install --upgrade --force-reinstall torch --index-url "https://download.pytorch.org/whl/rocm$rocm" || {
                printf 'ROCm PyTorch installation failed. Try: --rocm %s\n' "$rocm" >&2
                exit 1
            }
        fi
    else
        if [[ "$vendor" == "nvidia" ]]; then
            printf 'Installing a CUDA PyTorch build for the NVIDIA GPU.\n'
        elif [[ "$vendor" == "intel" ]]; then
            printf 'Warning: no supported local GPU runtime for Intel graphics; generation will use the CPU.\n' >&2
        else
            printf 'No supported GPU detected; installing the default PyTorch build (CPU fallback).\n'
        fi
        "$python_bin" -m pip install --upgrade torch || {
            printf 'PyTorch installation failed.\n' >&2
            exit 1
        }
    fi

    printf 'Installing diffusers and friends into %s\n' "$venv"
    "$python_bin" -m pip install --upgrade diffusers transformers accelerate safetensors sentencepiece protobuf pillow || {
        printf 'Dependency installation failed.\n' >&2
        exit 1
    }
    "$python_bin" "$helper" selftest || exit 1
    "$python_bin" "$helper" doctor || exit 1
    if ((prefetch)); then
        printf 'Downloading %s weights (this is a one-time download of several GB).\n' "${ASSISTANT_IMAGE_LOCAL_MODEL:-stabilityai/sdxl-turbo}"
        "$python_bin" "$helper" prefetch || {
            printf 'Weight download failed; run this command again to retry.\n' >&2
            exit 1
        }
    fi
    printf 'Local image backend ready. Pass backend local to generate_image, or set ASSISTANT_IMAGE_BACKEND=local.\n'
}

status() {
    local source="none"
    if [[ -n "${GEMINI_API_KEY:-}" ]]; then
        source="GEMINI_API_KEY environment variable"
    elif [[ -r "$key_file" && -s "$key_file" ]]; then
        source="$key_file"
    fi
    printf 'configured=%s\n' "$([[ "$source" == "none" ]] && printf 'no' || printf 'yes')"
    printf 'source=%s\n' "$source"
    printf 'model=%s\n' "${ASSISTANT_IMAGE_MODEL:-gemini-3-pro-image}"
    printf 'preferred_backend=%s\n' "${ASSISTANT_IMAGE_BACKEND:-gemini}"
    printf 'output_dir=%s\n' "$(output_dir)"
    printf 'hourly_limit=%s\n' "${ASSISTANT_IMAGE_HOURLY_LIMIT:-10}"
    printf 'daily_limit=%s\n' "${ASSISTANT_IMAGE_DAILY_LIMIT:-60}"
}

usage() {
    cat <<'EOF'
Usage: assistant-config <command>

  status                Show whether image generation is configured (never prints the key)
  set-key               Read a Gemini API key from stdin and store it with mode 600
  set-key --from-env    Store the value of GEMINI_API_KEY from the environment
  clear                 Delete the stored Gemini API key
  output-dir            Print the directory where generated images are saved
  image-status          Report local backend, GPU vendor, runtime, and cached weights
  image-setup-plan      Show which PyTorch build setup would install, without installing
  setup-image-models    Install the local backend (venv, PyTorch, SDXL-Turbo weights)

Options for setup-image-models:
  --no-prefetch         Install everything but skip the multi-GB weight download
  --backend VENDOR      Force nvidia, amd, intel, or none instead of detecting
  --rocm VERSION        Use a specific ROCm wheel index, for example 6.4
  --rebuild-torch       Reinstall PyTorch even if a matching build is present

Environment overrides: ASSISTANT_IMAGE_TORCH_BACKEND, ASSISTANT_ROCM_VERSION,
ASSISTANT_IMAGE_VENV, ASSISTANT_IMAGE_PYTHON, ASSISTANT_IMAGE_LOCAL_MODEL.
EOF
}

case "${1:-status}" in
    status)
        status
        ;;
    set-key)
        if [[ "${2:-}" == "--from-env" ]]; then
            if [[ -z "${GEMINI_API_KEY:-}" ]]; then
                printf 'GEMINI_API_KEY is not set in this shell.\n' >&2
                exit 1
            fi
            store_key "$GEMINI_API_KEY"
        else
            if [[ -t 0 ]]; then
                printf 'Paste the Gemini API key, then press enter: ' >&2
            fi
            IFS= read -r key
            store_key "$key"
        fi
        ;;
    clear)
        if [[ -e "$key_file" ]]; then
            rm -f "$key_file"
            printf 'Removed %s\n' "$key_file"
        else
            printf 'No stored key at %s\n' "$key_file"
        fi
        ;;
    output-dir)
        output_dir
        ;;
    image-status)
        image_status
        ;;
    image-setup-plan)
        image_setup_plan
        ;;
    setup-image-models)
        shift || true
        setup_image_models "$@"
        ;;
    help | -h | --help)
        usage
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac
